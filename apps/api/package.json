{
    "name": "api",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node --experimental-strip-types --env-file=.env --watch src/server.ts",
        "typecheck": "tsc --noEmit",
        "test": "node --env-file=.env.test --test src/**/*.test.ts",
        "migrate": "node --env-file=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js",
        "migrate:create": "node --env-file=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js create -j ts",
        "migrate:test": "node --env-file=.env.test node_modules/node-pg-migrate/bin/node-pg-migrate.js"
    },
    "dependencies": {
        "fastify": "^5.12.8",
        "fastify-type-provider-zod": "^7.0.0",
        "pg": "^8.23.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@types/pg": "^8.23.1",
        "node-pg-migrate": "^9.0.0",
        "typescript": "^7.0.2"
    }
}